From 5139751a21bf9b44e9f38ef60669f83b7857fabd Mon Sep 17 00:00:00 2001
From: Kartatz <105828205+Kartatz@users.noreply.github.com>
Date: Sat, 8 Aug 2026 18:20:53 +0000
Subject: [PATCH] Handle --enable-checking=release

---
 gcc/configure    | 1 +
 gcc/configure.in | 1 +
 2 files changed, 2 insertions(+)

diff --git a/gcc/configure b/gcc/configure
index 38d3db4fe27..a5619b4c3b5 100755
--- a/gcc/configure
+++ b/gcc/configure
@@ -770,6 +770,7 @@ yes)	cat >> confdefs.h <<\EOF
 EOF
  ;;
 no)	;;
+release) ;;
 *)	{ echo "configure: error: bad value ${enableval} given for checking option" 1>&2; exit 1; } ;;
 esac
 fi
diff --git a/gcc/configure.in b/gcc/configure.in
index 55dcec76823..cc2c8766f9b 100644
--- a/gcc/configure.in
+++ b/gcc/configure.in
@@ -180,6 +180,7 @@ AC_ARG_ENABLE(checking,
 [case "${enableval}" in
 yes)	AC_DEFINE(ENABLE_CHECKING) ;;
 no)	;;
+release) ;;
 *)	AC_MSG_ERROR(bad value ${enableval} given for checking option) ;;
 esac])
 
-- 
2.54.0

